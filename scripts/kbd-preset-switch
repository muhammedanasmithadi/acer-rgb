#!/bin/sh
# Cycle to the next keyboard preset
set -eu
export LC_ALL=C
profiles_dir="/etc/tailord/profiles"
active_link="/etc/tailord/active_profile.json"
cmd_file="/run/kbd-rgbd/cmd"

if ! [ -d "$profiles_dir" ]; then
    echo "error: $profiles_dir not found" >&2
    exit 1
fi

# Get current profile name from symlink target
if [ -L "$active_link" ]; then
    target=$(readlink "$active_link")
    current="${target##*/}"
    current="${current%.json}"
else
    current=""
fi

# Build sorted list of profile names (excluding .json extension)
names=
count=0
idx=0
next_idx=0
for f in "$profiles_dir"/*.json; do
    [ -f "$f" ] || continue
    base="${f##*/}"
    name="${base%.json}"
    names="$names $name"
    if [ "$name" = "$current" ]; then
        idx=$count
    fi
    count=$(( count + 1 ))
done

if [ "$count" -eq 0 ]; then
    echo "error: no profiles found" >&2
    exit 1
fi

next_idx=$(( (idx + 1) % count ))

# Get the next name from the sorted list
i=0
for name in $names; do
    if [ "$i" -eq "$next_idx" ]; then
        if ! [ -f "$cmd_file" ]; then
            echo "error: daemon not running (no $cmd_file)" >&2
            exit 1
        fi
        printf 'profile %s\n' "$name" > "$cmd_file"
        exit 0
    fi
    i=$(( i + 1 ))
done
echo "error: no profiles found" >&2
exit 1
