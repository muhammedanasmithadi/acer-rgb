#!/bin/sh
# List available keyboard presets
set -eu
export LC_ALL=C
dir="/etc/tailord/profiles"
if ! [ -d "$dir" ]; then
    echo "error: $dir not found" >&2
    exit 1
fi

current=
if [ -L "/etc/tailord/active_profile.json" ]; then
    target=$(readlink "/etc/tailord/active_profile.json")
    current="${target##*/}"
    current="${current%.json}"
fi

for f in "$dir"/*.json; do
    [ -f "$f" ] || continue
    base="${f##*/}"
    name="${base%.json}"
    if [ "$name" = "$current" ]; then
        printf '* %s (active)\n' "$name"
    else
        printf '  %s\n' "$name"
    fi
done
