#!/bin/sh
# Set a static keyboard backlight color, TUXEDO-style: one direct sysfs
# write, no daemon involved. The daemon rewrites multi_intensity
# continuously, so stop it first: sudo systemctl stop kbd-rgbd.service
#
# Usage: kbd-color RRGGBB   (e.g. kbd-color ff0000 for red)
set -eu

LED=/sys/class/leds/rgb:kbd_backlight

if [ "$#" -ne 1 ]; then
    echo "usage: $0 RRGGBB" >&2
    exit 1
fi
case "$1" in
    [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
    *) echo "error: '$1' is not a hex color (expected RRGGBB)" >&2; exit 1 ;;
esac
if [ ! -w "$LED/multi_intensity" ]; then
    echo "error: $LED/multi_intensity not writable" >&2
    exit 1
fi

r=$(printf '%d' "0x${1%????}")
g=$(printf '%d' "0x$(printf '%s' "$1" | cut -c3-4)")
b=$(printf '%d' "0x${1#????}")
printf '%d %d %d' "$r" "$g" "$b" > "$LED/multi_intensity"
