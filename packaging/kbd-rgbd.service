[Unit]
Description=Keyboard RGB Daemon — animates LED class device from profile JSONs
After=sysinit.target

[Service]
Type=simple
RuntimeDirectory=kbd-rgbd
RuntimeDirectoryMode=0755
ExecStart=/usr/local/bin/kbd-rgbd
ExecStop=/bin/sh -c 'flock /run/kbd-rgbd/cmd -c "printf stop\\n > /run/kbd-rgbd/cmd"'
TimeoutStopSec=2
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
